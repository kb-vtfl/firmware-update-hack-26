# Azure AI Foundry resource endpoint, e.g. https://<resource>.openai.azure.com or https://<resource>.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Deployment name of the model in Foundry (sent as "model")
AZURE_FOUNDRY_DEPLOYMENT=gpt-6-astra
# Optional full URL override; defaults to <AZURE_FOUNDRY_ENDPOINT>/openai/v1/responses
# AZURE_FOUNDRY_RESPONSES_URL=

# Business-rule tuning (defaults shown)
# ANALYSIS_WINDOW_HOURS=24
# LOW_ENERGY_THRESHOLD_KWH=2
# HEARTBEAT_GRACE_FACTOR=2
# DEFAULT_HEARTBEAT_INTERVAL_S=7200
# If set, a station already on this version is reported as ALREADY_ON_TARGET
# TARGET_FIRMWARE_VERSION=
# Reference "now" for the 24h window; defaults to the export end time in each file name
# AS_OF=2026-10-21T12:20:00Z

# Live station commands (OCPP 2.0.1)
# Firmware image location sent in UpdateFirmware; placeholders {version} {model} {stationId}.
# Credentials may be embedded (ftp://user:pass@host/...); they are masked in logs and tool output.
FIRMWARE_LOCATION_TEMPLATE=ftp://firmware.example.local/alfen/{model}/{version}/firmware.bin
# OCPP_CALL_TIMEOUT_MS=3000
# FIRMWARE_UPDATE_TIMEOUT_MS=30000
# FIRMWARE_RETRIES=3
# FIRMWARE_RETRY_INTERVAL_S=60

# Browser dashboard (npm run ui)
# UI_PORT=3000
# Initial duration of one simulated firmware step in the dashboard (changeable live in the UI)
# UI_FIRMWARE_STEP_MS=1800

# Firmware failure recovery: attempts per station (reboot + retry in between), follow-up delay
# FIRMWARE_MAX_ATTEMPTS=3
# REBOOT_TIMEOUT_MS=30000
# FOLLOW_UP_DELAY_HOURS=24

# Azure deployment (npm run deploy:azure): output/ (reports, tickets, follow-ups, run logs) is mounted from an
# Azure Files share so it survives redeploys. Set PERSIST_OUTPUT=0 to skip; the storage account name must be globally unique.
# PERSIST_OUTPUT=1
# STORAGE_ACCOUNT=fwrolloutrgvfhackuser19
# SHARE_NAME=fw-rollout-output

# Mock station behaviour (comma-separated station IDs)
# MOCK_OFFLINE_STATIONS=ALF-0011673
# Fault injection: download-once | install-once | download-always | install-always (also settable per card in the UI)
# MOCK_FIRMWARE_FAILURES=ALF-0069674=download-once,ALF-0073465=install-once
# MOCK_LATENCY_MS=150
# MOCK_FIRMWARE_STEP_MS=400
